{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:training:router-artifact:v0",
  "title": "Router Artifact",
  "description": "Serialized local router produced by `mg train router`. Version: modelgraph/router-artifact/v0. Weights are a conditional-logit score table, not a neural network.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_version",
    "feature_version",
    "method",
    "seed",
    "classes",
    "feature_dimension",
    "weights",
    "calibration",
    "abstain",
    "training",
    "dataset",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "modelgraph/router-artifact/v0"},
    "artifact_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "feature_version": {"const": "router-features-v1"},
    "features": {
      "type": "object",
      "description": "Feature-extraction switches used at training time. Optional for artifacts written before this block existed (bigrams default to true).",
      "additionalProperties": false,
      "required": ["bigrams"],
      "properties": {
        "bigrams": {"type": "boolean"}
      }
    },
    "method": {"const": "conditional-logit"},
    "seed": {"type": "integer"},
    "classes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "feature_dimension": {"type": "integer", "minimum": 32},
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "number"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "temperature",
        "fit_split",
        "fit_count",
        "ece",
        "nll"
      ],
      "properties": {
        "method": {"const": "temperature"},
        "temperature": {"type": "number", "exclusiveMinimum": 0},
        "fit_split": {"const": "validation"},
        "fit_count": {"type": "integer", "minimum": 0},
        "ece": {"type": ["number", "null"]},
        "nll": {"type": ["number", "null"]},
        "bins": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "abstain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "fit_split", "cost_matrix", "validation"],
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "fit_split": {"const": "validation"},
        "cost_matrix": {"$ref": "#/$defs/costMatrix"},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost_per_case", "coverage", "abstain_rate", "oracle_agreement"],
          "properties": {
            "cost_per_case": {"type": "number"},
            "coverage": {"type": "number", "minimum": 0, "maximum": 1},
            "abstain_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "oracle_agreement": {"type": ["number", "null"]}
          }
        },
        "grid_steps": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochs",
        "learning_rate",
        "l2",
        "optimizer",
        "class_weight",
        "train_count",
        "final_loss"
      ],
      "properties": {
        "epochs": {"type": "integer", "minimum": 1},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "l2": {"type": "number", "minimum": 0},
        "optimizer": {"type": "string", "minLength": 1},
        "class_weight": {"type": "string", "enum": ["none", "balanced"]},
        "train_count": {"type": "integer", "minimum": 1},
        "final_loss": {"type": "number"},
        "loss_history": {
          "type": "array",
          "items": {"type": "number"}
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "split_counts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1},
        "split_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "group_count": {"type": "integer", "minimum": 0},
        "frozen_test": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "command", "config_hash"],
      "properties": {
        "source": {"const": "mg train router"},
        "command": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "minLength": 1},
        "code_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "costMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct_route",
        "misroute",
        "unnecessary_abstain",
        "misroute_ambiguous",
        "correct_abstain"
      ],
      "properties": {
        "correct_route": {"type": "number", "minimum": 0},
        "misroute": {"type": "number", "minimum": 0},
        "unnecessary_abstain": {"type": "number", "minimum": 0},
        "misroute_ambiguous": {"type": "number", "minimum": 0},
        "correct_abstain": {"type": "number", "minimum": 0}
      }
    }
  }
}
