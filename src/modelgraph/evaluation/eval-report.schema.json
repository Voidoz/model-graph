{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:eval-report:v0",
  "title": "Eval Report",
  "description": "Machine-readable report produced by modelgraph.evaluation. Node, routing, and paired-comparison reports share this shape. Version: modelgraph/eval-report/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "level",
    "claim",
    "generated_at",
    "suite",
    "graph",
    "target",
    "provider",
    "command",
    "commands",
    "reproduce",
    "run_manifest",
    "environment",
    "selection",
    "budget",
    "metrics",
    "primary_metric",
    "thresholds",
    "gate",
    "cases",
    "failures",
    "slices",
    "protocol_errors",
    "costs",
    "latency",
    "usage",
    "determinism",
    "limitations",
    "oracle",
    "calibration",
    "confusion",
    "abstain",
    "judge",
    "comparisons",
    "baseline",
    "candidate"
  ],
  "properties": {
    "schema": {"const": "modelgraph/eval-report/v0"},
    "report_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "level": {"type": "string", "enum": ["node", "routing", "e2e", "comparison"]},
    "claim": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "minLength": 1},
    "suite": {"$ref": "#/$defs/suite"},
    "graph": {
      "oneOf": [{"$ref": "#/$defs/graph"}, {"type": "null"}]
    },
    "target": {"type": "object", "additionalProperties": true},
    "provider": {"type": "object", "additionalProperties": true},
    "command": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reproduce": {"type": "string", "minLength": 1},
    "run_manifest": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "additionalProperties": true},
    "selection": {"type": "object", "additionalProperties": true},
    "budget": {"type": "object", "additionalProperties": true},
    "metrics": {"type": "object", "additionalProperties": true},
    "primary_metric": {
      "type": "object",
      "required": ["name", "value", "threshold", "direction", "passed"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "ci95": {
          "oneOf": [
            {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            {"type": "null"}
          ]
        },
        "threshold": {"type": ["number", "null"]},
        "direction": {"type": "string", "enum": ["min", "max"]},
        "passed": {"type": ["boolean", "null"]}
      }
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "threshold", "value", "direction", "passed"],
        "additionalProperties": true
      }
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["passed"],
          "additionalProperties": true,
          "properties": {"passed": {"type": "boolean"}}
        },
        {"type": "null"}
      ]
    },
    "cases": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "failures": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "slices": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": true}
    },
    "protocol_errors": {"type": "object", "additionalProperties": true},
    "costs": {"type": "object", "additionalProperties": true},
    "latency": {"type": "object", "additionalProperties": true},
    "usage": {"type": "object", "additionalProperties": true},
    "determinism": {
      "type": "object",
      "required": ["scripted_provider", "fingerprint"],
      "additionalProperties": true,
      "properties": {
        "scripted_provider": {"type": "boolean"},
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "oracle": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "calibration": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "confusion": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "abstain": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "judge": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "comparisons": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "baseline": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "candidate": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    },
    "e2e": {
      "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "required": ["id", "version", "hash"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "path": {"type": "string"},
        "level": {"type": "string", "enum": ["node", "routing", "e2e"]},
        "claim": {"type": ["string", "null"]}
      }
    },
    "graph": {
      "type": "object",
      "required": ["id", "version", "hash"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path": {"type": "string"}
      }
    }
  }
}
