{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:run-manifest:v0",
  "title": "Run Manifest",
  "description": "Evidence for one run: graph/model/renderer/parser/profile/prune identity, budget, seed, environment, outcome, usage, artifacts, trace, and parent linkage. Written provisionally at run start and atomically finalized. Version: modelgraph/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "deployment_revision",
    "target",
    "status",
    "outcome",
    "graph",
    "request",
    "models",
    "budget",
    "seed",
    "environment",
    "renderer_version",
    "parser_version",
    "ir_version",
    "profile_hash",
    "prune_hash",
    "started_at",
    "finished_at",
    "usage",
    "path",
    "artifacts",
    "exit_artifacts",
    "trace",
    "error",
    "parent_run_id"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "deployment_revision": {"type": "string", "pattern": "^rev_[A-Za-z0-9_-]{1,96}$"},
    "target": {
      "type": "string",
      "enum": ["portable", "resident", "fused", "compiled", "distilled", "auto"]
    },
    "status": {
      "type": "string",
      "enum": ["provisional", "final", "interrupted"],
      "description": "provisional while running, final after atomic finalization, interrupted after recovery."
    },
    "outcome": {
      "type": "string",
      "enum": ["running", "succeeded", "failed", "budget_exhausted", "interrupted"]
    },
    "graph": {"$ref": "#/$defs/graph"},
    "request": {"$ref": "#/$defs/request"},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "budget": {"$ref": "#/$defs/budget"},
    "seed": {"type": ["integer", "null"]},
    "environment": {"$ref": "#/$defs/environment"},
    "renderer_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "parser_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "ir_version": {"type": "string", "const": "modelgraph/ir/v0"},
    "profile": {
      "type": "object",
      "description": "The effective profile, verbatim. Additive profile fields are allowed.",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "profile_hash": {"$ref": "#/$defs/nullableHash"},
    "prune": {
      "type": "object",
      "description": "The applied prune report, verbatim.",
      "additionalProperties": true
    },
    "prune_hash": {"$ref": "#/$defs/nullableHash"},
    "started_at": {"type": "string", "minLength": 1, "maxLength": 50},
    "finished_at": {"type": ["string", "null"], "minLength": 1, "maxLength": 50},
    "usage": {"$ref": "#/$defs/usage"},
    "path": {"type": "array", "items": {"$ref": "#/$defs/pathEntry"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "exit_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "trace": {"type": "string", "minLength": 1, "maxLength": 300},
    "error": {"$ref": "#/$defs/nullableError"},
    "parent_run_id": {"type": ["string", "null"], "maxLength": 100},
    "subgraphs": {
      "type": "array",
      "description": "Child subgraph runs persisted under subgraphs/<run-id>/.",
      "items": {"$ref": "#/$defs/subgraphRun"}
    },
    "model_loads": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "nodeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "artifactName": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "hash": {"$ref": "#/$defs/hash"},
        "source": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task"],
      "properties": {
        "task": {"type": "string", "minLength": 1, "maxLength": 200000}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "ref",
        "version",
        "hash",
        "provider",
        "model",
        "resolved_revision",
        "revision_reason"
      ],
      "properties": {
        "node": {"$ref": "#/$defs/nodeId"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": ["string", "null"], "maxLength": 64},
        "hash": {"$ref": "#/$defs/nullableHash"},
        "provider": {
          "type": ["string", "null"],
          "enum": ["mock", "openai-compatible", "ollama", "llamacpp", "custom", null]
        },
        "model": {"type": ["string", "null"], "maxLength": 300},
        "resolved_revision": {"type": ["string", "null"], "maxLength": 200},
        "revision_reason": {"type": ["string", "null"], "maxLength": 300},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["chat", "json_mode", "streaming", "seeded", "grammar"]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "used_steps",
        "max_depth",
        "max_total_tokens",
        "used_tokens",
        "max_cost_usd",
        "used_cost_usd",
        "max_wall_seconds",
        "elapsed_seconds",
        "on_budget_exhausted"
      ],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "used_steps": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "used_tokens": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "used_cost_usd": {"type": "number", "minimum": 0},
        "max_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "on_budget_exhausted": {"type": "string", "enum": ["fail", "best_effort"]}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_usd",
        "elapsed_seconds"
      ],
      "properties": {
        "steps": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelgraph_version",
        "python_version",
        "python_implementation",
        "platform",
        "machine",
        "cpu_count",
        "memory_bytes",
        "hostname",
        "pid",
        "providers"
      ],
      "properties": {
        "modelgraph_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "python_implementation": {"type": "string", "minLength": 1, "maxLength": 64},
        "platform": {"type": "string", "minLength": 1, "maxLength": 300},
        "machine": {"type": "string", "maxLength": 100},
        "cpu_count": {"type": ["integer", "null"], "minimum": 1},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 1},
        "hostname": {"type": ["string", "null"], "maxLength": 300},
        "pid": {"type": ["integer", "null"], "minimum": 1},
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 100},
              "version": {"type": ["string", "null"], "maxLength": 64}
            }
          }
        }
      }
    },
    "pathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "kind"],
      "properties": {
        "node": {"$ref": "#/$defs/nodeId"},
        "kind": {"type": "string", "enum": ["router", "worker", "joiner", "subgraph"]},
        "decision": {"type": "string", "enum": ["route", "abstain"]},
        "to": {"$ref": "#/$defs/nodeId"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "maxLength": 500},
        "graph": {"type": "string", "maxLength": 200},
        "graph_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "hash", "producer", "bytes", "exit"],
      "properties": {
        "name": {"$ref": "#/$defs/artifactName"},
        "type": {"type": "string", "enum": ["text", "code", "patch", "plan", "json", "report"]},
        "hash": {"$ref": "#/$defs/nullableHash"},
        "producer": {"type": "string", "minLength": 1, "maxLength": 100},
        "bytes": {"type": "integer", "minimum": 0},
        "exit": {"type": "boolean"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hash"],
      "properties": {
        "name": {"$ref": "#/$defs/artifactName"},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "nullableError": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^MG-[0-9]{4}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 5000},
        "path": {"type": ["string", "null"], "maxLength": 500},
        "details": {"type": "object", "additionalProperties": true}
      }
    },
    "subgraphRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "graph",
        "hash",
        "run_id",
        "parent_run_id",
        "status",
        "outcome",
        "manifest"
      ],
      "properties": {
        "node": {"$ref": "#/$defs/nodeId"},
        "graph": {"type": "string", "minLength": 1, "maxLength": 100},
        "hash": {"$ref": "#/$defs/hash"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "parent_run_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "status": {"type": "string", "enum": ["provisional", "final", "interrupted"]},
        "outcome": {
          "type": "string",
          "enum": ["running", "succeeded", "failed", "budget_exhausted", "interrupted"]
        },
        "manifest": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    }
  }
}
