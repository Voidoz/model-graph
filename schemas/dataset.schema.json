{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:dataset:v0",
  "title": "Dataset Manifest",
  "description": "Manifest and JSONL record contract for trace-derived datasets. The top-level document is the dataset manifest (kind: Dataset). Each line of examples.jsonl validates against #/$defs/example and declares schema modelgraph/dataset-example/v0. Version: modelgraph/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "modelgraph/v0"},
    "kind": {"const": "Dataset"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "license", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string", "maxLength": 200}
        },
        "license": {"type": "string", "minLength": 1, "maxLength": 200},
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "distributable"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "uri": {"type": ["string", "null"]},
        "distributable": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "kind",
        "run_id",
        "run_outcome",
        "graph",
        "trace",
        "license",
        "group",
        "manifest_hash",
        "trace_hash"
      ],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "kind": {"const": "run"},
        "run_id": {"type": "string", "minLength": 1},
        "run_outcome": {"type": "string", "minLength": 1},
        "graph": {"$ref": "#/$defs/graph"},
        "trace": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "trace_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test", "total"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "by_kind": {"$ref": "#/$defs/countMap"},
        "by_node": {
          "$ref": "#/$defs/countMap",
          "description": "Examples grouped by the node that produced them. A routing example is credited to its router, so this map counts all examples and can sum above total."
        },
        "by_route": {"$ref": "#/$defs/countMap"},
        "by_outcome": {"$ref": "#/$defs/countMap"}
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dedupe", "filters", "split_strategy", "group_by"],
      "properties": {
        "dedupe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "near_duplicate_distance",
            "exact_removed",
            "near_removed"
          ],
          "properties": {
            "mode": {"type": "string", "enum": ["none", "exact", "near", "exact+near"]},
            "near_duplicate_distance": {"type": "integer", "minimum": 0, "maximum": 64},
            "exact_removed": {"type": "integer", "minimum": 0},
            "near_removed": {"type": "integer", "minimum": 0}
          }
        },
        "filters": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "split_strategy": {"type": "string", "minLength": 1},
        "group_by": {"type": "string", "enum": ["source", "graph", "run", "license"]},
        "group_overrides": {"type": "integer", "minimum": 0}
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_against", "excluded", "threshold", "matches", "notes"],
      "properties": {
        "status": {"type": "string", "enum": ["checked", "not-checked"]},
        "checked_against": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "hash"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "hash": {"type": "string", "minLength": 1}
            }
          }
        },
        "excluded": {"type": "integer", "minimum": 0},
        "threshold": {"type": "integer", "minimum": 0, "maximum": 64},
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["example", "suite", "suite_hash", "case_id", "method"],
            "properties": {
              "example": {"type": "string", "minLength": 1},
              "suite": {"type": "string", "minLength": 1},
              "suite_hash": {"type": "string", "minLength": 1},
              "case_id": {"type": "string", "minLength": 1},
              "method": {"type": "string", "enum": ["exact", "near-duplicate"]}
            }
          }
        },
        "notes": {"type": ["string", "null"]}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "recorded", "statement", "scope"],
      "properties": {
        "required": {"type": "boolean"},
        "recorded": {"type": "boolean"},
        "statement": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "status",
        "action",
        "report",
        "patterns",
        "total_redactions",
        "clean"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"type": "string", "enum": ["disabled", "clean", "redacted"]},
        "action": {"type": "string", "enum": ["hash", "mask", "drop"]},
        "report": {"type": "string", "minLength": 1},
        "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "total_redactions": {"type": "integer", "minimum": 0},
        "clean": {"type": "boolean"}
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "group_by",
        "seed",
        "ratios",
        "counts",
        "frozen_test",
        "plan",
        "plan_hash",
        "groups",
        "hashes"
      ],
      "properties": {
        "strategy": {"const": "group_hash"},
        "group_by": {"type": "string", "enum": ["source", "graph", "run", "license"]},
        "seed": {"type": "string", "minLength": 1},
        "ratios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"type": "number", "minimum": 0, "maximum": 1},
            "validation": {"type": "number", "minimum": 0, "maximum": 1},
            "test": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "counts": {"$ref": "#/$defs/splitCounts"},
        "frozen_test": {"type": "boolean"},
        "plan": {"type": "string", "minLength": 1},
        "plan_hash": {"$ref": "#/$defs/hash"},
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["split", "examples"],
            "properties": {
              "split": {"type": "string", "enum": ["train", "validation", "test"]},
              "examples": {"type": "integer", "minimum": 0}
            }
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"$ref": "#/$defs/hash"},
            "validation": {"$ref": "#/$defs/hash"},
            "test": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "splitCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    },
    "exampleCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "routing", "total", "by_node", "by_route"],
      "properties": {
        "node": {"type": "integer", "minimum": 0},
        "routing": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "by_node": {
          "$ref": "#/$defs/countMap",
          "description": "Examples grouped by the node that produced them. Routing examples are credited to the router."
        },
        "by_route": {"$ref": "#/$defs/countMap"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command", "source_runs"],
      "properties": {
        "tool": {"const": "mg data export"},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "source_runs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "skippedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "outcome", "reason"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "format",
        "record_schema",
        "sources",
        "preprocessing",
        "counts",
        "hash",
        "files",
        "eval_contamination",
        "consent",
        "redaction",
        "splits",
        "examples",
        "license",
        "provenance",
        "skipped_runs",
        "limitations"
      ],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "format": {"const": "jsonl"},
        "record_schema": {"const": "modelgraph/dataset-example/v0"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "preprocessing": {"$ref": "#/$defs/preprocessing"},
        "counts": {"$ref": "#/$defs/counts"},
        "hash": {"$ref": "#/$defs/hash"},
        "files": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/hash"}
        },
        "eval_contamination": {"$ref": "#/$defs/contamination"},
        "consent": {"$ref": "#/$defs/consent"},
        "redaction": {"$ref": "#/$defs/redaction"},
        "splits": {"$ref": "#/$defs/splits"},
        "examples": {"$ref": "#/$defs/exampleCounts"},
        "license": {"$ref": "#/$defs/license"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "skipped_runs": {"type": "array", "items": {"$ref": "#/$defs/skippedRun"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "content", "hash", "bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "hash": {"$ref": "#/$defs/hash"},
        "source_hash": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "content"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "nodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "prompt_hash", "rendered", "messages"],
      "properties": {
        "task": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "rendered": {"type": "boolean"},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/inputArtifact"}}
      }
    },
    "routingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "prompt_hash", "rendered", "messages", "menu"],
      "properties": {
        "task": {"type": "string"},
        "prompt_hash": {"type": ["string", "null"]},
        "rendered": {"type": "boolean"},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "menu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "text", "routes"],
          "properties": {
            "available": {"type": "boolean"},
            "text": {"type": ["string", "null"]},
            "routes": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "approximated": {"type": "boolean"}
      },
      "additionalProperties": {"type": ["number", "boolean", "string", "null"]}
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "nodeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "finish_reason", "usage", "attempts", "error"],
      "properties": {
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "finish_reason": {"type": ["string", "null"]},
        "usage": {"$ref": "#/$defs/usage"},
        "attempts": {"type": "integer", "minimum": 1},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      }
    },
    "routingOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chosen_route",
        "chosen_decision",
        "confidence",
        "threshold",
        "reason",
        "fallback_used",
        "finish_reason",
        "usage",
        "error"
      ],
      "properties": {
        "chosen_route": {"type": ["string", "null"]},
        "chosen_decision": {
          "type": ["string", "null"],
          "enum": ["route", "fallback", null]
        },
        "confidence": {"type": ["number", "null"]},
        "threshold": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]},
        "fallback_used": {"type": "boolean"},
        "finish_reason": {"type": ["string", "null"]},
        "usage": {"$ref": "#/$defs/usage"},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact", "passed", "detail"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "artifact": {"type": ["string", "null"]},
        "passed": {"type": "boolean"},
        "detail": {"type": "string"}
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "source"],
      "properties": {
        "outcome": {"type": "string", "enum": ["success", "failure", "unknown"]},
        "source": {
          "type": "string",
          "enum": ["eval_check", "human_label", "run_outcome", "oracle", "unknown"]
        },
        "route": {"type": ["string", "null"]},
        "should_abstain": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"]},
        "labeler": {"type": ["string", "null"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/checkResult"}}
      }
    },
    "exampleRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "redacted", "patterns"],
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "redacted": {"type": "boolean"},
        "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "exampleHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "example"],
      "properties": {
        "input": {"$ref": "#/$defs/hash"},
        "output": {"$ref": "#/$defs/hash"},
        "example": {"$ref": "#/$defs/hash"}
      }
    },
    "exampleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trace",
        "run_outcome",
        "graph",
        "node",
        "node_kind",
        "event_index"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "trace": {"type": "string", "minLength": 1},
        "run_outcome": {"type": "string", "minLength": 1},
        "graph": {"$ref": "#/$defs/graph"},
        "node": {"type": "string", "minLength": 1},
        "node_kind": {"type": "string", "minLength": 1},
        "event_index": {"type": "integer", "minimum": 0}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "example_id",
        "kind",
        "split",
        "group",
        "source",
        "input",
        "output",
        "label",
        "consent",
        "license",
        "redaction",
        "hashes"
      ],
      "properties": {
        "schema": {"const": "modelgraph/dataset-example/v0"},
        "example_id": {"type": "string", "pattern": "^ex_[0-9a-f]{16}$"},
        "kind": {"type": "string", "enum": ["node", "routing"]},
        "split": {"type": "string", "enum": ["train", "validation", "test"]},
        "group": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/exampleSource"},
        "input": {"type": "object"},
        "output": {"type": "object"},
        "label": {"$ref": "#/$defs/label"},
        "consent": {"$ref": "#/$defs/consent"},
        "license": {"$ref": "#/$defs/license"},
        "redaction": {"$ref": "#/$defs/exampleRedaction"},
        "hashes": {"$ref": "#/$defs/exampleHashes"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "node"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "input": {"$ref": "#/$defs/nodeInput"},
              "output": {"$ref": "#/$defs/nodeOutput"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "routing"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "input": {"$ref": "#/$defs/routingInput"},
              "output": {"$ref": "#/$defs/routingOutput"}
            }
          }
        }
      ]
    }
  }
}
