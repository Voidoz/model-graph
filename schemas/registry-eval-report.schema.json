{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:registry-eval-report:v0",
  "title": "Registry Eval Report",
  "description": "The evidence a registry contribution must ship: a passing node-suite and graph-regression report over a graph pinned to the contributed model, with content hashes for every referenced file. Version: modelgraph/registry-eval-report/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model",
    "command",
    "reproduce",
    "suite",
    "graph",
    "evidence",
    "seeds",
    "hardware",
    "results",
    "passed",
    "generated_at",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "modelgraph/registry-eval-report/v0"},
    "model": {"$ref": "#/$defs/model"},
    "command": {"type": "string", "minLength": 1},
    "reproduce": {"type": "string", "minLength": 1},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "graph"],
      "properties": {
        "node": {"$ref": "#/$defs/suiteRef"},
        "graph": {"$ref": "#/$defs/suiteRef"}
      }
    },
    "graph": {"$ref": "#/$defs/graphRef"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "graph"],
      "properties": {
        "node": {"$ref": "#/$defs/evidence"},
        "graph": {"$ref": "#/$defs/evidence"}
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number", "string"]}
    },
    "hardware": {"type": "object"},
    "environment": {"type": "object"},
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "graph"],
      "properties": {
        "node": {"$ref": "#/$defs/levelResult"},
        "graph": {"$ref": "#/$defs/levelResult"}
      }
    },
    "passed": {"type": "boolean"},
    "generated_at": {"type": "string", "minLength": 1},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "suiteRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "graphRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "pinned_model"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "hash": {"$ref": "#/$defs/hash"},
        "pinned_model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "run_manifest"],
      "properties": {
        "report": {"$ref": "#/$defs/fileRef"},
        "run_manifest": {"$ref": "#/$defs/fileRef"}
      }
    },
    "levelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "cases", "task_success", "validity"],
      "properties": {
        "passed": {"type": "boolean"},
        "cases": {"type": "integer", "minimum": 0},
        "task_success": {"type": ["number", "null"]},
        "validity": {"type": ["number", "null"]},
        "protocol_error_rate": {"type": ["number", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
