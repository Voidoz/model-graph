{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:graph:v0",
  "title": "Model Graph",
  "description": "A declarative graph of router, worker, joiner, and subgraph nodes connected by language artifacts. Version: modelgraph/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "modelgraph/v0"},
    "kind": {"const": "Graph"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "graphId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Stable, lowercase, URL-safe graph identifier."
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Node identifier, unique within a graph."
    },
    "artifactName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Artifact name used in reads, writes, inputs, and exit lists."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "subgraphRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
      "description": "Pinned graph reference, id@version."
    },
    "artifactType": {
      "type": "string",
      "enum": ["text", "code", "patch", "plan", "json", "report"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 200}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/graphId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"$ref": "#/$defs/semver"},
        "description": {"type": "string", "minLength": 10, "maxLength": 1000},
        "labels": {"$ref": "#/$defs/labels"},
        "authors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "minItems": 1
        },
        "license": {"type": "string", "minLength": 1, "maxLength": 200},
        "homepage": {"type": "string", "maxLength": 500}
      }
    },
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/artifactName"},
        "type": {"$ref": "#/$defs/artifactType"},
        "required": {"type": "boolean", "default": true},
        "description": {"type": "string", "maxLength": 500},
        "media_type": {"type": "string", "maxLength": 100}
      }
    },
    "artifactWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/artifactName"},
        "type": {"$ref": "#/$defs/artifactType"},
        "description": {"type": "string", "maxLength": 500},
        "media_type": {"type": "string", "maxLength": 100},
        "strict_json": {"type": "boolean", "default": false}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 131072},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "on_overflow": {"type": "string", "enum": ["error", "truncate"], "default": "error"}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "type": "string",
          "enum": ["single", "top_k", "all"],
          "default": "single",
          "description": "How many menu routes this router activates: one, the k best, or all."
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Number of routes to activate when selection is top_k."
        },
        "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.7},
        "on_low_confidence": {
          "type": "string",
          "enum": ["error", "fallback", "retry"],
          "default": "error"
        },
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5, "default": 1},
        "allow_direct_answer": {"type": "boolean", "default": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"selection": {"const": "top_k"}},
            "required": ["selection"]
          },
          "then": {"required": ["k"]}
        },
        {
          "if": {
            "properties": {"selection": {"enum": ["single", "all"]}},
            "required": ["selection"]
          },
          "then": {"properties": {"k": false}}
        },
        {
          "if": {"not": {"required": ["selection"]}},
          "then": {"properties": {"k": false}}
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "kind": {"type": "string", "enum": ["router", "worker", "joiner", "subgraph"]},
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "Human and router-facing summary of what this node does."
        },
        "labels": {"$ref": "#/$defs/labels"},
        "reads": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactName"},
          "uniqueItems": true,
          "description": "Artifacts this node is allowed to see."
        },
        "writes": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactWrite"},
          "minItems": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Model manifest ID resolved through the registry."
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "System instruction for worker and joiner nodes."
        },
        "routing": {"$ref": "#/$defs/routing"},
        "limits": {"$ref": "#/$defs/limits"},
        "routing_card": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Optional hand-tuned capability card override for routers."
        },
        "graph": {"$ref": "#/$defs/subgraphRef"},
        "input_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactName"},
          "description": "Outer artifact name -> inner graph input name."
        },
        "output_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactName"},
          "description": "Outer artifact name -> inner graph exit artifact name."
        },
        "strategy": {
          "type": "string",
          "enum": ["merge", "pick_best", "synthesize"],
          "default": "synthesize"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "router"}}, "required": ["kind"]},
          "then": {
            "required": ["model"],
            "properties": {
              "writes": false,
              "instruction": false,
              "graph": false,
              "input_map": false,
              "output_map": false,
              "strategy": false
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "worker"}}, "required": ["kind"]},
          "then": {
            "required": ["model", "instruction", "writes"],
            "properties": {
              "routing": false,
              "graph": false,
              "input_map": false,
              "output_map": false,
              "strategy": false
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "joiner"}}, "required": ["kind"]},
          "then": {
            "required": ["model", "writes"],
            "properties": {
              "routing": false,
              "graph": false,
              "input_map": false,
              "output_map": false
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "subgraph"}}, "required": ["kind"]},
          "then": {
            "required": ["graph", "input_map", "output_map", "writes"],
            "properties": {
              "model": false,
              "instruction": false,
              "routing": false,
              "limits": false,
              "strategy": false
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/nodeId"},
        "to": {"$ref": "#/$defs/nodeId"},
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Routing criterion. Required for router outgoing edges."
        },
        "examples": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "maxItems": 5
        },
        "artifact": {"$ref": "#/$defs/artifactType"},
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 64, "default": 8},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 8, "default": 3},
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "default": 32000
        },
        "max_cost_usd": {"type": "number", "minimum": 0, "default": 0.25},
        "max_wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "default": 300
        },
        "on_budget_exhausted": {
          "type": "string",
          "enum": ["fail", "best_effort"],
          "default": "fail"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit", "nodes", "edges"],
      "properties": {
        "entry": {"$ref": "#/$defs/nodeId"},
        "exit": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactName"},
          "minItems": 1,
          "uniqueItems": true,
          "description": "Artifact names returned to the caller."
        },
        "inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactInput"},
          "uniqueItems": true
        },
        "fallback": {
          "$ref": "#/$defs/nodeId",
          "description": "Node invoked when a router abstains or falls below threshold."
        },
        "defaults": {"$ref": "#/$defs/defaults"},
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"},
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    }
  }
}
