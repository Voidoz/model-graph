{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:ticket:v0",
  "title": "Ticket Frontmatter",
  "description": "The YAML frontmatter of a work ticket in .scratch/tickets. Version: modelgraph/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "phase",
    "area",
    "size",
    "priority",
    "created",
    "updated"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^T-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 200},
    "status": {
      "type": "string",
      "enum": ["todo", "ready", "in-progress", "blocked", "review", "done", "dropped"]
    },
    "phase": {"type": "integer", "minimum": 0, "maximum": 4},
    "area": {
      "type": "string",
      "enum": [
        "foundations",
        "compiler",
        "runtime",
        "protocol",
        "providers",
        "evaluation",
        "training",
        "registry",
        "experience",
        "security",
        "observability",
        "docs"
      ]
    },
    "size": {"type": "string", "enum": ["XS", "S", "M", "L", "XL"]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "depends_on": {
      "type": "array",
      "items": {"type": "string", "pattern": "^T-[0-9]{4}$"},
      "uniqueItems": true
    },
    "owner": {"type": ["string", "null"], "maxLength": 100},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "labels": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 50},
      "uniqueItems": true
    },
    "blocked_reason": {"type": ["string", "null"], "maxLength": 500}
  }
}
