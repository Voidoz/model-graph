{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelgraph:schema:change-set:v0",
  "title": "Change Set",
  "description": "A proposed graph/model/target change, its candidate deployment revision, evidence links, and promotion record. Version: modelgraph/v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "status",
    "created_at",
    "updated_at",
    "change_class",
    "target",
    "base_target",
    "base_revision",
    "candidate_revision",
    "summary",
    "graph",
    "candidate_graph",
    "bindings",
    "impact_file",
    "evidence",
    "promotion"
  ],
  "properties": {
    "schema": {"const": "modelgraph/change-set/v0"},
    "change_id": {"type": "string", "pattern": "^chg_[A-Za-z0-9_-]{1,96}$"},
    "status": {
      "type": "string",
      "enum": ["draft", "evaluated", "compiled", "promotable", "promoted", "rejected"]
    },
    "created_at": {"type": "string", "minLength": 1, "maxLength": 50},
    "updated_at": {"type": "string", "minLength": 1, "maxLength": 50},
    "change_class": {
      "type": "string",
      "enum": [
        "initial",
        "prompt",
        "adapter_swap",
        "model_swap",
        "base_swap",
        "router_swap",
        "topology",
        "target",
        "student"
      ]
    },
    "target": {
      "type": "string",
      "enum": ["portable", "resident", "fused", "compiled", "distilled", "auto"]
    },
    "base_target": {
      "type": ["string", "null"],
      "enum": ["portable", "resident", "fused", "compiled", "distilled", "auto", null]
    },
    "base_revision": {
      "type": ["string", "null"],
      "pattern": "^rev_[A-Za-z0-9_-]{1,96}$"
    },
    "candidate_revision": {"type": "string", "pattern": "^rev_[A-Za-z0-9_-]{1,96}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "graph": {"oneOf": [{"$ref": "#/$defs/graph"}, {"type": "null"}]},
    "candidate_graph": {"$ref": "#/$defs/graph"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "impact_file": {"const": "impact.json"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "promotion": {
      "oneOf": [{"$ref": "#/$defs/promotion"}, {"type": "null"}]
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "hash": {"$ref": "#/$defs/hash"},
        "source": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "from_ref", "to_ref", "from_hash", "to_hash"],
      "properties": {
        "node": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "from_ref": {"type": ["string", "null"], "maxLength": 300},
        "to_ref": {"type": ["string", "null"], "maxLength": 300},
        "from_hash": {"$ref": "#/$defs/nullableHash"},
        "to_hash": {"$ref": "#/$defs/nullableHash"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "valid",
        "level",
        "report_id",
        "suite",
        "graph_hash",
        "gate_passed",
        "cases",
        "sha256",
        "errors"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2000},
        "valid": {"type": "boolean"},
        "level": {"type": "string", "minLength": 1, "maxLength": 64},
        "report_id": {"type": ["string", "null"], "maxLength": 200},
        "suite": {"type": ["string", "null"], "maxLength": 200},
        "graph_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gate_passed": {"type": "boolean"},
        "cases": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promoted_at",
        "revision",
        "reason",
        "evidence",
        "coverage",
        "rollback_target"
      ],
      "properties": {
        "promoted_at": {"type": "string", "minLength": 1, "maxLength": 50},
        "revision": {"type": "string", "pattern": "^rev_[A-Za-z0-9_-]{1,96}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "maxLength": 2000}
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {"type": "array", "items": {"type": "string"}},
            "satisfied": {"type": "array", "items": {"type": "string"}},
            "complete": {"type": "boolean"}
          }
        },
        "rollback_target": {
          "type": ["string", "null"],
          "pattern": "^rev_[A-Za-z0-9_-]{1,96}$"
        }
      }
    }
  }
}
