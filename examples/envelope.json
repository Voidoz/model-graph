    {
      "name": "answer",
      "type": "code",
      "media_type": "text/typescript",
      "content": "export function debounce<T extends (...args: any[]) => void>(fn: T, ms = 200) {\n  let timer: ReturnType<typeof setTimeout> | undefined;\n  return (...args: Parameters<T>) => {\n    if (timer) clearTimeout(timer);\n    timer = setTimeout(() => fn(...args), ms);\n  };\n}",
      "producer": "js-specialist",
      "created_at": "2026-10-22T10:00:04Z",
